{
  "name": "yuku",
  "version": "0.22.0",
  "description": "A JavaScript and TypeScript compiler toolchain written in Zig",
  "license": "MIT",
  "homepage": "https://yuku.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuku-toolchain/yuku",
    "directory": "packages/yuku"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./yuku.wasm": "./dist/yuku.wasm",
    "./package.json": "./package.json"
  },
  "imports": {
    "#native": {
      "node": "./dist/native/load.js",
      "default": "./dist/native/none.js"
    },
    "#wasm": {
      "workerd": "./dist/wasm/import.js",
      "edge-light": "./dist/wasm/import.js",
      "default": "./dist/wasm/inline.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "preferUnplugged": true,
  "engines": {
    "node": ">=16.4.0"
  },
  "keywords": [
    "analyzer",
    "ast",
    "codegen",
    "compiler",
    "ecmascript",
    "estree",
    "javascript",
    "jsx",
    "minifier",
    "parser",
    "scope",
    "sourcemap",
    "tokenizer",
    "typescript",
    "walker",
    "webassembly"
  ],
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
