{
  "name": "yuku",
  "version": "0.20.0",
  "description": "A JavaScript and TypeScript compiler toolchain written in Zig",
  "license": "MIT",
  "homepage": "https://yuku.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuku-toolchain/yuku",
    "directory": "packages/yuku"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./analyzer": {
      "types": "./dist/analyzer.d.ts",
      "default": "./dist/analyzer.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./yuku.wasm": "./dist/yuku.wasm",
    "./package.json": "./package.json"
  },
  "imports": {
    "#module": {
      "workerd": "./dist/module/workerd.js",
      "default": "./dist/module/inline.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "engines": {
    "node": ">=16.4.0"
  },
  "keywords": [
    "analyzer",
    "ast",
    "codegen",
    "compiler",
    "ecmascript",
    "estree",
    "javascript",
    "jsx",
    "minifier",
    "parser",
    "scope",
    "sourcemap",
    "tokenizer",
    "typescript",
    "walker",
    "webassembly"
  ],
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
