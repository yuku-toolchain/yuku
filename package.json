{
  "name": "yuku-root",
  "version": "",
  "private": true,
  "homepage": "https://yuku.fyi",
  "license": "MIT",
  "author": "Arshad Yaseen <arshadpyaseen@gmail.com> (https://arshad.fyi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuku-toolchain/yuku.git"
  },
  "funding": "https://github.com/sponsors/arshad-yaseen",
  "workspaces": [
    "npm/**/*"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "test": "bun fetch:fixtures && bun build:local && bun build:wasm && bun typecheck && bun test:parser && bun test:codegen && bun test:ast && bun test:analyzer && bun test:wasm && bun test:sourcemap && bun test:runtime",
    "typecheck": "tsc --noEmit",
    "test:parser": "bun test/parser/run.ts && bun test test/parser",
    "test:codegen": "bun run --cwd npm/yuku-codegen build && zig build codegen-reference && bun test test/codegen",
    "test:ast": "bun test test/ast",
    "test:analyzer": "bun test test/analyzer",
    "test:wasm": "bun test test/wasm",
    "test:runtime": "bun build ./test/runtime/smoke.ts --target=node --packages=external --outfile=zig-out/runtime-smoke.mjs && node zig-out/runtime-smoke.mjs",
    "test:sourcemap": "bun test/sourcemap/run.ts",
    "test:tools": "zig build test-tools",
    "test:fuzz": "zig build fuzz",
    "playground": "bun build:wasm && bun run --cwd npm/yuku-codegen build && bun playground/server.ts",
    "format": "zig fmt **/*.zig",
    "docs:llms": "bun docs/generate-llms.ts",
    "build:local": "napi-zig build --release --current && bun gen:npm",
    "build:npm": "napi-zig build --release && bun gen:npm",
    "build:wasm": "zig build wasm && cp ./zig-out/bin/yuku-core.wasm ./npm/yuku-core-wasm/",
    "release:npm": "napi-zig bump",
    "fetch:fixtures": "bun test/parser/load test/parser/suite && bun test/projects/load.ts",
    "gen:npm": "zig build gen-token-types gen-parser-decoder gen-analyzer-decoder gen-walk-tables && cp ./zig-out/tokens.d.ts ./npm/yuku-types && cp ./zig-out/decode.js ./npm/yuku-parser && cp ./zig-out/decode-analyzer.js ./npm/yuku-analyzer/decode.js && cp ./zig-out/walk-tables.ts ./npm/yuku-ast/src/generated.ts && bun run --cwd npm/yuku-ast build && bun run --cwd npm/yuku-codegen build"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.2",
    "@typescript-eslint/scope-manager": "^8.70.1",
    "@typescript-eslint/typescript-estree": "^8.70.1",
    "@yuku-core/wasm": "workspace:*",
    "fast-deep-equal": "^3.1.3",
    "jest-diff": "^30.5.2",
    "napi-zig": "^0.3.1",
    "pkg-pr-new": "0.0.88",
    "typescript": "^6.0.3",
    "yuku-analyzer": "workspace:*",
    "yuku-ast": "workspace:*",
    "yuku-codegen": "workspace:*",
    "yuku-core": "workspace:*",
    "yuku-parser": "workspace:*"
  }
}
