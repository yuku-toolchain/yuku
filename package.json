{
  "name": "yuku-root",
  "version": "",
  "private": true,
  "type": "module",
  "homepage": "https://yuku.fyi",
  "license": "MIT",
  "author": "Arshad Yaseen <arshadpyaseen@gmail.com> (https://arshad.fyi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuku-toolchain/yuku.git"
  },
  "funding": "https://github.com/sponsors/arshad-yaseen",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=16.4.0"
  },
  "scripts": {
    "test": "bun fetch:fixtures && bun run build && bun typecheck && bun test:parser && bun test:codegen && bun test:ast && bun test:analyzer && bun test:dialect && bun test:sourcemap && bun test:runtime",
    "typecheck": "tsc --noEmit && tsc --noEmit --project packages/yuku",
    "test:parser": "bun test/parser/run.ts && bun test test/parser",
    "test:codegen": "bun run --cwd packages/yuku build && zig build codegen-reference && bun test test/codegen",
    "test:ast": "bun test test/ast",
    "test:analyzer": "bun test test/analyzer",
    "test:dialect": "zig build wasm -Ddialect=src/parser/testing/dialect.zig --prefix zig-out/dialect && bun test test/dialect",
    "test:runtime": "bun build ./test/runtime/smoke.ts --target=node --packages=external --outfile=zig-out/runtime-smoke.mjs && node zig-out/runtime-smoke.mjs",
    "test:sourcemap": "bun test/sourcemap/run.ts",
    "test:tools": "zig build test-tools",
    "test:fuzz": "zig build fuzz",
    "playground": "bun run build && bun playground/server.ts",
    "format": "zig fmt **/*.zig",
    "docs:llms": "bun docs/generate-llms.ts",
    "build": "zig build package && bun run --cwd packages/yuku build",
    "release:npm": "bun .github/scripts/release.ts",
    "fetch:fixtures": "bun test/parser/load test/parser/suite && bun test/projects/load.ts",
    "fetch:profile": "bun test/projects/load.ts typescript zod excalidraw three",
    "profile": "bun fetch:profile && bun run build && node profile/package.ts"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "6.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.2",
    "@typescript-eslint/scope-manager": "^8.70.1",
    "@typescript-eslint/typescript-estree": "^8.70.1",
    "fast-deep-equal": "^3.1.3",
    "jest-diff": "^30.5.2",
    "pkg-pr-new": "0.0.88",
    "tinybench": "6.2.2",
    "typescript": "^6.0.3",
    "yuku": "workspace:*"
  }
}
