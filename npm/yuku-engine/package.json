{
  "name": "yuku-engine",
  "version": "0.15.1",
  "description": "The native binary that the Yuku packages run on",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuku-toolchain/yuku"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "native.js"
  ],
  "optionalDependencies": {
    "@yuku-engine/binding-linux-x64-gnu": "0.15.1",
    "@yuku-engine/binding-linux-arm64-gnu": "0.15.1",
    "@yuku-engine/binding-linux-arm-gnu": "0.15.1",
    "@yuku-engine/binding-linux-x64-musl": "0.15.1",
    "@yuku-engine/binding-linux-arm64-musl": "0.15.1",
    "@yuku-engine/binding-linux-arm-musl": "0.15.1",
    "@yuku-engine/binding-darwin-x64": "0.15.1",
    "@yuku-engine/binding-darwin-arm64": "0.15.1",
    "@yuku-engine/binding-win32-x64": "0.15.1",
    "@yuku-engine/binding-win32-arm64": "0.15.1",
    "@yuku-engine/binding-freebsd-x64": "0.15.1",
    "@yuku-engine/binding-android-arm64": "0.15.1"
  },
  "engines": {
    "node": ">=14.18.0"
  },
  "imports": {
    "#engine": {
      "browser": "@yuku-engine/wasm",
      "node": "./native.js",
      "default": "@yuku-engine/wasm"
    }
  },
  "dependencies": {
    "@yuku-toolchain/types": "workspace:^"
  },
  "peerDependencies": {
    "@yuku-engine/wasm": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yuku-engine/wasm": {
      "optional": true
    }
  },
  "sideEffects": false
}
