{
  "name": "yuku-codegen",
  "version": "0.13.0",
  "description": "JavaScript and TypeScript code generator for ESTree and TypeScript-ESTree ASTs: formatting, minification, TypeScript stripping, and source maps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuku-toolchain/yuku"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=14.18.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@yuku-toolchain/types": "workspace:^"
  },
  "keywords": [
    "ast",
    "codegen",
    "estree",
    "printer",
    "minifier",
    "sourcemap",
    "typescript",
    "javascript",
    "yuku"
  ],
  "module": "./dist/index.js",
  "sideEffects": false
}
