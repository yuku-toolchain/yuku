{
  "name": "yuku-core",
  "version": "0.15.1",
  "description": "Yuku's native core, the compiled code every Yuku package runs on",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuku-toolchain/yuku"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "browser.js",
    "options.js"
  ],
  "optionalDependencies": {
    "@yuku-core/binding-linux-x64-gnu": "0.15.1",
    "@yuku-core/binding-linux-arm64-gnu": "0.15.1",
    "@yuku-core/binding-linux-arm-gnu": "0.15.1",
    "@yuku-core/binding-linux-x64-musl": "0.15.1",
    "@yuku-core/binding-linux-arm64-musl": "0.15.1",
    "@yuku-core/binding-linux-arm-musl": "0.15.1",
    "@yuku-core/binding-darwin-x64": "0.15.1",
    "@yuku-core/binding-darwin-arm64": "0.15.1",
    "@yuku-core/binding-win32-x64": "0.15.1",
    "@yuku-core/binding-win32-arm64": "0.15.1",
    "@yuku-core/binding-freebsd-x64": "0.15.1",
    "@yuku-core/binding-android-arm64": "0.15.1"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14.18.0"
  },
  "dependencies": {
    "@yuku-toolchain/types": "workspace:^"
  },
  "keywords": [
    "javascript",
    "parser",
    "typescript",
    "yuku"
  ],
  "sideEffects": false
}
